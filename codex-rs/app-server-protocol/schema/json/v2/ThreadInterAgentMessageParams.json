          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtimeBackend": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "InterAgentDeliveryMode": {
